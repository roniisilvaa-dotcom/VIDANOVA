# Configuração de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores

# Chave secreta para gerar tokens JWT
# Gere uma chave forte aqui: https://openssl.rand-hex 32
JWT_SECRET=sua_chave_muito_secreta_mudar_em_producao_123456789

# Porta do servidor
PORT=3001

# Banco de dados (desenvolvimento usa SQLite)
# Para produção, mude para PostgreSQL
DATABASE_URL=sqlite:./vida-nova.db

# Variáveis para produção com PostgreSQL em Render
# POSTGRES_USER=seu_usuario
# POSTGRES_PASSWORD=sua_senha
# POSTGRES_HOST=seu-db.render.internal
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=vida_nova_db

# Chave de API da Kiwifi (para integração de vendas)
KIWIFI_API_KEY=sua_chave_kiwifi_aqui
KIWIFI_PRODUCT_ID=seu_id_produto_kiwifi

# Ambiente (development ou production)
NODE_ENV=development

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:3001

# Email para notificações (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_app_gmail

# Webhook da Kiwifi (para receber pagamentos)
WEBHOOK_SECRET=sua_chave_webhook_kiwifi
