rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Users shouldn't be listable
      allow create: if isOwner(userId)
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email;
      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email;
    }

    // Event Rules
    match /events/{eventId} {
      function isValidEvent(data) {
        return data.userId == request.auth.uid
          && data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.start is timestamp
          && data.end is timestamp
          && (data.description == null || (data.description is string && data.description.size() <= 2000))
          && (data.location == null || (data.location is string && data.location.size() <= 500))
          && (data.color == null || (data.color is string && data.color.matches('^#[0-9A-Fa-f]{6}$')))
          && (data.isAllDay is bool);
      }

      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidEvent(incoming())
        && incoming().createdAt == request.time;
        
      allow update: if isSignedIn() 
        && existing().userId == request.auth.uid
        && isValidEvent(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
        
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
